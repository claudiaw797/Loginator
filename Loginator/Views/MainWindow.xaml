<Window x:Class="Loginator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Loginator.Views"
        DataContext="{Binding LoginatorViewModel, Source={StaticResource Locator}}"
        WindowStartupLocation="CenterScreen"
        Title="Loginator" Height="700" Width="1000" MinHeight="600" MinWidth="920"
        Icon="../Resources/icon.ico">

    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <views:Toolbar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" />

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="60" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" x:Name="SelectedLogRow" />
            </Grid.RowDefinitions>

            <views:LogListView Grid.Row="0" />

            <GridSplitter Grid.Row="1" x:Name="SplitterRow"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Height="4" HorizontalAlignment="Stretch" />

            <views:LogDetailsView Grid.Row="2" />
        </Grid>
        
        <GridSplitter Grid.Row="1" Grid.Column="1"
                      ResizeBehavior="BasedOnAlignment" ResizeDirection="Columns" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="200" />
                <RowDefinition Height="4" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <views:ApplicationsView Grid.Row="0" />

            <GridSplitter Grid.Row="1" ResizeBehavior="BasedOnAlignment" ResizeDirection="Rows" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <views:NamespacesView Grid.Row="2" />
        </Grid>
    </Grid>
</Window>
