<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="brush.level.Trace" Color="DarkGray" />
    <SolidColorBrush x:Key="brush.level.Debug" Color="Gray" />
    <SolidColorBrush x:Key="brush.level.Info" Color="Green" />
    <SolidColorBrush x:Key="brush.level.Warn" Color="DarkOrange" />
    <SolidColorBrush x:Key="brush.level.Error" Color="Red" />
    <SolidColorBrush x:Key="brush.level.Fatal" Color="DarkViolet" />
    <SolidColorBrush x:Key="brush.LogHighlight" Color="LightGoldenrodYellow" />
</ResourceDictionary>