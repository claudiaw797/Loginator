<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:s="clr-namespace:System;assembly=mscorlib"
                    xmlns:converter="clr-namespace:Loginator.Gui.WPF.Converter"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Control}" x:Key="BaseStyle">
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>
    <Style TargetType="{x:Type Label}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Height" Value="26" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Height" Value="22" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Height" Value="22" />
    </Style>
    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
    </Style>

    <converter:ConnectionStateToImageConverter x:Key="ConnectionStateToImageConverter" />
    <converter:ExistsToVisibilityConverter x:Key="ExistsToVisibilityConverter" />
    <converter:KeyToResourceStringConverter x:Key="KeyToResourceStringConverter" />
    <converter:ObjectToBoolConverter x:Key="ObjectToBoolConverter" />
    <converter:ObjectToFormattedResourceStringConverter x:Key="ObjectToFormattedResourceStringConverter" />
    <converter:StringToIntConverter x:Key="StringToIntConverter" />
    <converter:TimestampConverter x:Key="TimestampConverter" />

    <s:Boolean x:Key="True">True</s:Boolean>
    <s:Boolean x:Key="False">False</s:Boolean>
</ResourceDictionary>