<UserControl x:Class="Loginator.Gui.WPF.View.LogListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:control="clr-namespace:Loginator.Gui.WPF.Control"
             xmlns:converter="clr-namespace:Loginator.Gui.WPF.Converter"
             xmlns:model="clr-namespace:Loginator.Domain.Model;assembly=Loginator.Domain"
             xmlns:viewmodel="clr-namespace:Loginator.Application.ViewModel;assembly=Loginator.Application"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodel:LoginatorViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">

    <ListView SelectedItem="{Binding SelectedLog}"
              ItemsSource="{Binding Logs}"
              Name="lvLogs"
              SelectionMode="Single"
              control:GridViewColumnResize.Enabled="True">
        <ListView.Resources>
            <converter:SingleLineTextConverter x:Key="SingleLineTextConverter" />
            <!--
            <Style TargetType="ListViewItem">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                        <Setter Property="ListBoxItem.Visibility" Value="Collapsed" />
                        <Setter Property="Height" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            -->
        </ListView.Resources>
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Level}" Value="{x:Static model:LogLevel.TRACE}">
                        <Setter Property="Foreground" Value="{DynamicResource brush.level.Trace}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Level}" Value="{x:Static model:LogLevel.DEBUG}">
                        <Setter Property="Foreground" Value="{DynamicResource brush.level.Debug}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Level}" Value="{x:Static model:LogLevel.INFO}">
                        <Setter Property="Foreground" Value="{DynamicResource brush.level.Info}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Level}" Value="{x:Static model:LogLevel.WARN}">
                        <Setter Property="Foreground" Value="{DynamicResource brush.level.Warn}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Level}" Value="{x:Static model:LogLevel.ERROR}">
                        <Setter Property="Foreground" Value="{DynamicResource brush.level.Error}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Level}" Value="{x:Static model:LogLevel.FATAL}">
                        <Setter Property="Foreground" Value="{DynamicResource brush.level.Fatal}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsHighlighted}" Value="true">
                        <Setter Property="Background" Value="{DynamicResource brush.LogHighlight}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ListView.ItemContainerStyle>
        <ListView.View>
            <GridView AllowsColumnReorder="False">
                <GridViewColumn Header="{DynamicResource lab.Timestamp}" control:GridViewColumnResize.Width="140">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss.fff}', Converter={StaticResource TimestampConverter}}" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="{DynamicResource lab.Level}" control:GridViewColumnResize.Width="50">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Level.Name}" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="{DynamicResource lab.Message}" control:GridViewColumnResize.Width="*">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message, Converter={StaticResource SingleLineTextConverter}}" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="{DynamicResource lab.Context}" control:GridViewColumnResize.Width="100">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Context, Converter={StaticResource SingleLineTextConverter}}" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="{DynamicResource lab.Process}" control:GridViewColumnResize.Width="50">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Process}" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
            </GridView>
        </ListView.View>
    </ListView>
</UserControl>
