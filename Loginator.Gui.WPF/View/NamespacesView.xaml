<UserControl x:Class="Loginator.Gui.WPF.View.NamespacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:control="clr-namespace:Loginator.Gui.WPF.Control"             
             xmlns:converter="clr-namespace:Loginator.Gui.WPF.Converter"             
             xmlns:viewmodel="clr-namespace:Loginator.Application.ViewModel;assembly=Loginator.Application"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodel:LoginatorViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">

    <control:ExtendedTreeView ItemsSource="{Binding Namespaces}"
                              SelectedItem="{Binding SelectedNamespace, Mode=TwoWay}">
        <TreeView.Resources>
            <converter:IsHitTestVisibleConverter x:Key="IsHitTestVisibleConverter" />
            <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
            </Style>
        </TreeView.Resources>

        <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <CheckBox Focusable="False" Height="20" Padding="1"
                          IsChecked="{Binding IsActive}">
                    <CheckBox.IsHitTestVisible>
                        <MultiBinding Converter="{StaticResource IsHitTestVisibleConverter}">
                            <Binding Path="Count" />
                            <Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType=TreeViewItem}" />
                        </MultiBinding>
                    </CheckBox.IsHitTestVisible>
                    <StackPanel Orientation="Horizontal" Height="20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="true">
                                        <Setter Property="Background" Value="{DynamicResource brush.LogHighlight}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Margin="3,1,0,0"
                                   Text="{Binding Name}" />
                        <StackPanel Orientation="Horizontal" Margin="7,4,4,0"
                                    Visibility="{Binding Count, Converter={StaticResource ExistsToVisibilityConverter}}">
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="8" />
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="[" />
                            <TextBlock Text="{Binding Count}" />
                            <TextBlock Text=":" />
                            <TextBlock Text="{Binding CountTrace}" Foreground="{DynamicResource brush.level.Trace}" />
                            <TextBlock Text="," />
                            <TextBlock Text="{Binding CountDebug}" Foreground="{DynamicResource brush.level.Debug}" />
                            <TextBlock Text="," />
                            <TextBlock Text="{Binding CountInfo}" Foreground="{DynamicResource brush.level.Info}" />
                            <TextBlock Text="," />
                            <TextBlock Text="{Binding CountWarn}" Foreground="{DynamicResource brush.level.Warn}" />
                            <TextBlock Text="," />
                            <TextBlock Text="{Binding CountError}" Foreground="{DynamicResource brush.level.Error}" />
                            <TextBlock Text="," />
                            <TextBlock Text="{Binding CountFatal}" Foreground="{DynamicResource brush.level.Fatal}" />
                            <TextBlock Text="]" />
                        </StackPanel>
                    </StackPanel>
                </CheckBox>
            </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
    </control:ExtendedTreeView>
</UserControl>
