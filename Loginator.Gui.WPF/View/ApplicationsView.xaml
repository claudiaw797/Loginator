<UserControl x:Class="Loginator.Gui.WPF.View.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:s="clr-namespace:System;assembly=mscorlib"
             xmlns:control="clr-namespace:Loginator.Gui.WPF.Control"
             xmlns:viewmodel="clr-namespace:Loginator.Application.ViewModel;assembly=Loginator.Application"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodel:LoginatorViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">

    <ListView ItemsSource="{Binding Applications}"
              SelectionMode="Single"
              control:GridViewColumnResize.Enabled="True">
        <ListView.Resources>
            <s:Boolean x:Key="True">True</s:Boolean>
            <s:Boolean x:Key="False">False</s:Boolean>
        </ListView.Resources>

        <ListView.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{DynamicResource cmd.SelectAll}" Command="{Binding ActivateAllApplicationsCommand}" CommandParameter="{StaticResource True}" />
                <MenuItem Header="{DynamicResource cmd.UnselectAll}" Command="{Binding ActivateAllApplicationsCommand}" CommandParameter="{StaticResource False}" />
                <Separator />
                <control:MenuItemGroup
                    Header="{Binding SelectedInitialLogLevel, Converter={StaticResource ObjectToFormattedResourceStringConverter}, ConverterParameter=grp.InitialLogLevel}"
                    ToolTip="{DynamicResource msg.InitialLogLevel}"
                    ItemsSource="{Binding LogLevels}"
                    DisplayMemberPath="Name"
                    SelectedValue="{Binding SelectedInitialLogLevel}" />
            </ContextMenu>
        </ListView.ContextMenu>

        <ListView.View>
            <GridView AllowsColumnReorder="False">
                <GridViewColumn Header="{DynamicResource lab.Level}" control:GridViewColumnResize.Width="90">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding LogLevels}" DisplayMemberPath="Name" SelectedValue="{Binding SelectedMinLogLevel}" Width="70"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="{DynamicResource lab.Application}" control:GridViewColumnResize.Width="*">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsActive}"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
            </GridView>
        </ListView.View>
    </ListView>
</UserControl>
