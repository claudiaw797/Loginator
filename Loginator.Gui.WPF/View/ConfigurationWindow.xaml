<Window x:Class="Loginator.Gui.WPF.View.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:aoption="clr-namespace:Loginator.Application.Option;assembly=Loginator.Application"
        xmlns:doption="clr-namespace:Loginator.Domain.Option;assembly=Loginator.Domain"
        xmlns:ioption="clr-namespace:Loginator.Infrastructure.Option;assembly=Loginator.Infrastructure"
        xmlns:control="clr-namespace:Loginator.Gui.WPF.Control"
        xmlns:viewmodel="clr-namespace:Loginator.Application.ViewModel;assembly=Loginator.Application"
        mc:Ignorable="d" 
        d:DataContext="{d:DesignInstance Type=viewmodel:ConfigurationViewModel}"
        DataContext="{control:ServiceProvider viewmodel:ConfigurationViewModel}"
        Icon="../Resources/Settings.png" Title="{DynamicResource grp.Settings}"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen" MinWidth="293" MinHeight="275">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Padding" Value="0,0,0,5" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="22" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Padding="2,5,8,8">
            <TabItem Header="{DynamicResource grp.Display}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Grid.ColumnSpan="3" Grid.Row="0"
                           Content="{DynamicResource grp.ApplicationFormat}" />
                    <RadioButton Grid.Column="2" Grid.Row="1"
                                 Content="{DynamicResource lab.AppConsolidate}" GroupName="ApplicationFormat"
                                 IsChecked="{Binding ApplicationFormat, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter={x:Static doption:ApplicationFormat.Consolidate}}" />
                    <RadioButton Grid.Column="2" Grid.Row="2"
                                 Content="{DynamicResource lab.AppNoChange}" GroupName="ApplicationFormat"
                                 IsChecked="{Binding ApplicationFormat, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter={x:Static doption:ApplicationFormat.DoNotChange}}" />

                    <Label Grid.ColumnSpan="3" Grid.Row="4"
                           Content="{DynamicResource grp.TimeFormat}" />
                    <RadioButton Grid.Column="2" Grid.Row="5"
                                 Content="{DynamicResource lab.TimeConvertLocal}" GroupName="TimeFormat"
                                 IsChecked="{Binding LogTimeFormat, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter={x:Static aoption:LogTimeFormat.ConvertToLocalTime}}" />
                    <RadioButton Grid.Column="2" Grid.Row="6"
                                 Content="{DynamicResource lab.TimeNoChange}" GroupName="TimeFormat"
                                 IsChecked="{Binding LogTimeFormat, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter={x:Static aoption:LogTimeFormat.DoNotChange}}" />

                    <Label Grid.Column="0" Grid.Row="8"
                           Content="{DynamicResource lab.Language}" />
                    <ComboBox Grid.Column="2" Grid.Row="8"
                              ItemsSource="{Binding Source={control:EnumBindingSource {x:Type aoption:KnownCulture}}}"
                              SelectedValue="{Binding Language}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ., Converter={StaticResource KeyToResourceStringConverter}, ConverterParameter='cmd.{0}'}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource grp.Connection}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Grid.ColumnSpan="3" Grid.Row="0"
                           Content="{DynamicResource grp.NetworkProtocol}" />
                    <RadioButton Grid.Column="2" Grid.Row="1"
                                 Content="{DynamicResource lab.Udp}" GroupName="ConnectionType"
                                 IsChecked="{Binding ConnectionType, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter={x:Static ioption:ConnectionType.Udp}}" />
                    <RadioButton Grid.Column="2" Grid.Row="2"
                                 Content="{DynamicResource lab.Tcp}" GroupName="ConnectionType"
                                 IsChecked="{Binding ConnectionType, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter={x:Static ioption:ConnectionType.Tcp}}" />

                    <Label Grid.Column="0" Grid.Row="4"
                           Content="{DynamicResource lab.Port}" />
                    <TextBox Grid.Column="2" Grid.Row="4"
                             Width="100" HorizontalAlignment="Left"
                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource msg.Port}" />

                    <Label Grid.ColumnSpan="3" Grid.Row="6"
                           Content="{DynamicResource grp.SourceType}" />
                    <RadioButton Grid.Column="2" Grid.Row="7"
                                 Content="{DynamicResource lab.Log4j}" GroupName="Source"
                                 IsChecked="{Binding LogType, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter={x:Static ioption:LogType.Log4j}}" />
                    <RadioButton Grid.Column="2" Grid.Row="8"
                                 Content="{DynamicResource lab.Logcat}" GroupName="Source"
                                 IsChecked="{Binding LogType, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter={x:Static ioption:LogType.Logcat}}" />
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource grp.General}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <CheckBox Margin="7,6,0,5"
                              Content="{DynamicResource lab.CheckUpdate}"
                              IsChecked="{Binding CheckForUpdateOnStartup}" />
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    Margin="0,5,0,0" HorizontalAlignment="Right">
            <Button Content="{DynamicResource cmd.Save}" Command="{Binding AcceptChangesCommand}" Width="80" />
            <Button Content="{DynamicResource cmd.Cancel}" Command="{Binding CancelChangesCommand}" Width="80" Margin="5,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
